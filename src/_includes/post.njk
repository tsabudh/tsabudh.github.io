---
layout: layout.njk
---
<header class="fixed top-0 w-full px-4 pt-1 flex gap-4 justify-between bg-transparent z-[9000]">
  <div class="z-1000 w-fit">
    <a href="/" class="uppercase font-lexend font-semibold text-slate-900">
      t.sabudh
    </a>
  </div>
  <nav class="font-semibold self-start max-md:text-right" aria-label="Primary navigation">
    <a href="/about/" class="relative before:content-[''] before:absolute before:bottom-0 before:left-0 before:w-full before:border-b-2 before:border-amber-400 before:scale-x-0 before:origin-right hover:before:scale-x-100 hover:before:origin-left before:transition-transform before:duration-300">About</a>,
    <a href="/blog/" class="relative before:content-[''] before:absolute before:bottom-0 before:left-0 before:w-full before:border-b-2 before:border-amber-400 before:scale-x-0 before:origin-right hover:before:scale-x-100 hover:before:origin-left before:transition-transform before:duration-300">Blog</a>,
    <a href="/hire/" class="relative before:content-[''] before:absolute before:bottom-0 before:left-0 before:w-full before:border-b-2 before:border-amber-400 before:scale-x-0 before:origin-right hover:before:scale-x-100 hover:before:origin-left before:transition-transform before:duration-300">Hire</a>,
    <a href="/contact/" class="relative before:content-[''] before:absolute before:bottom-0 before:left-0 before:w-full before:border-b-2 before:border-amber-400 before:scale-x-0 before:origin-right hover:before:scale-x-100 hover:before:origin-left before:transition-transform before:duration-300">Contact</a>
  </nav>
</header>

<main class="px-5">
  <article class="mx-auto max-w-3xl pt-28 pb-16">
    <p class="uppercase font-lexend text-sm font-semibold tracking-wide text-amber-600">
      {{ category }} · {{ readTime }} min read · <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
    </p>
    <h1 class="mt-6 font-lexend font-bold text-slate-950 text-[clamp(40px,6vw,72px)] leading-[0.95]">
      {{ title }}
    </h1>
    <p class="mt-6 text-2xl leading-relaxed text-slate-600 max-md:text-xl">
      {{ description }}
    </p>
    <p class="mt-6 text-sm text-slate-500">
      By <a href="/about/" class="font-semibold text-slate-700 underline decoration-amber-400 decoration-2 underline-offset-4">Sabudh Thapa</a>, backend and distributed systems engineer in Kathmandu, Nepal.
    </p>

    <div class="post-body mt-14 border-t border-slate-300 pt-10">
      {{ content | safe }}
    </div>

    <footer class="mt-16 border-t border-slate-300 pt-8 text-slate-600">
      <p>
        Originally published on
        <a href="{{ mediumUrl }}" target="_blank" rel="noopener" class="font-semibold text-slate-800 underline decoration-amber-400 decoration-2 underline-offset-4">Medium</a>.
        This page is the canonical version.
      </p>
      <p class="mt-4">
        Working on a system with the same failure shapes? I take remote backend contracts from Nepal.
        <a href="/hire/" class="font-semibold text-amber-700 underline decoration-amber-400 decoration-2 underline-offset-4">How I work with teams</a>
        ·
        <a href="/blog/" class="font-semibold text-slate-800 underline decoration-amber-400 decoration-2 underline-offset-4">More notes</a>
      </p>
    </footer>
  </article>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "@id": "{{ site.url }}{{ page.url }}#article",
      "mainEntityOfPage": "{{ site.url }}{{ page.url }}",
      "url": "{{ site.url }}{{ page.url }}",
      "headline": {{ title | dump | safe }},
      "description": {{ description | dump | safe }},
      "datePublished": "{{ date | isoDate }}",
      "dateModified": "{{ date | isoDate }}",
      "inLanguage": "en",
      "keywords": {{ keywords | dump | safe }},
      "image": "{{ image or site.image }}",
      "sameAs": "{{ mediumUrl }}",
      "author": { "@id": "{{ site.url }}/#sabudh-thapa" },
      "publisher": { "@id": "{{ site.url }}/#sabudh-thapa" },
      "isPartOf": { "@id": "{{ site.url }}/#website" }
    }
  </script>

  {% include "footer.njk" %}
</main>
